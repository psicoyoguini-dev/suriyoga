<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Programas | Suri Yoga</title>
  <meta name="description" content="Programas Suri Yoga para infancias y adolescencias." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --arena: #f8f5f0;
      --salvia: #9caf88;
      --arcilla: #cfa58d;
      --gris: #3f3f3f;
      --verde-oscuro: #2f3e46;
    }
    * {
      box-sizing: border-box;
    }
    html {
      scroll-behavior: smooth;
    }
    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background-color: var(--arena);
      color: var(--gris);
      line-height: 1.7;
    }
    nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      background-color: var(--arena);
      box-shadow: 0 2px 8px rgba(0,0,0,0.07);
      z-index: 1000;
      font-weight: 500;
      font-family: 'Inter', sans-serif;
    }
    nav div {
      max-width: 1000px;
      margin: auto;
      display: flex;
      justify-content: center;
      gap: 40px;
      padding: 15px 10px;
    }
    nav a {
      text-decoration: none;
      color: var(--verde-oscuro);
      font-size: 1rem;
      padding: 6px 10px;
      border-radius: 8px;
      transition: background-color 0.3s ease, color 0.3s ease;
    }
    nav a:hover,
    nav a:focus {
      background-color: var(--salvia);
      color: white;
      outline: none;
    }
    .spacer {
      height: 65px;
    }
    header.logo {
      text-align: center;
      margin: 40px 0 40px;
    }
    header.logo img {
      max-width: 220px;
      width: 80%;
      height: auto;
      display: inline-block;
    }
    section {
      max-width: 900px;
      margin: auto;
      padding: 0 20px 60px;
    }
    h2 {
      font-family: 'Playfair Display', serif;
      color: var(--verde-oscuro);
      font-weight: 500;
      font-size: 2rem;
      margin-bottom: 30px;
      text-align: center;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 30px;
      margin-bottom: 50px;
    }
    .box {
      background-color: white;
      padding: 30px;
      border-radius: 18px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.04);
      color: var(--gris);
      cursor: pointer;
      transition: transform 0.2s ease;
    }
    .box:hover {
      transform: translateY(-6px);
      box-shadow: 0 14px 30px rgba(0,0,0,0.08);
    }
    a.box-link {
      text-decoration: none;
      color: inherit;
      display: block;
    }
    footer {
      text-align: center;
      padding: 30px 10px;
      font-size: 0.9rem;
      color: #666;
      background-color: var(--arena);
      border-top: 1px solid #ddd;
    }
  </style>
</head>
<body>

<nav>
  <div>
    <a href="index.html">Contexto</a>
    <a href="programas.html">Programas</a>
    <a href="quien-acompana.html">Quién acompaña</a>
    <a href="contacto.html">Contacto</a>
  </div>
</nav>
<div class="spacer"></div>

<header class="logo">
  <img src="img/logo-suri.png" alt="Suri Yoga Logo" />
</header>

<section>
  <h2>Programas</h2>
  <div class="grid">
    <a href="raiz.html" class="box-link">
      <div class="box">
        <h3>Raíz · Infancias</h3>
        <p>Programa para niños y niñas de 3 a 12 años dividido en Cali, Radi y Brote.</p>
      </div>
    </a>
    <a href="pausa.html" class="box-link">
      <div class="box">
        <h3>Pausa · Adolescencias</h3>
        <p>Programa para adolescentes de 13 a 18 años dividido en Ritmo y Pulso.</p>
      </div>
    </a>
    <a href="trama.html" class="box-link">
      <div class="box">
        <h3>Trama · Instituciones</h3>
        <p>Programa para instituciones educativas con modalidades de talleres, programas periódicos y propuestas personalizadas.</p>
      </div>
    </a>
    <a href="semilla.html" class="box-link">
      <div class="box">
        <h3>Semilla · Baby Yoga</h3>
        <p>Próximamente: un espacio de yoga para bebés y familias en construcción.</p>
      </div>
    </a>
  </div>
</section>

<footer>
  <p>© 2026 Suri Yoga · Del Viso – Pilar</p>
</footer>

</body>
</html>
